.wrap { display: flex; flex-direction: column; height: 100vh; }
.bar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; background: #fff; border-bottom: 1rpx solid #e8e3dc; }
.back { font-size: 26rpx; color: #6B5B95; }
.ttl { text-align: center; }
.nm { font-size: 32rpx; font-weight: 600; }
.sub2 { font-size: 20rpx; color: #8a8a8a; }
.cbody { flex: 1; padding: 28rpx; box-sizing: border-box; background: #FAF8F5; }
.msg { max-width: 78%; padding: 20rpx 26rpx; border-radius: 30rpx; font-size: 30rpx; line-height: 1.5; margin-bottom: 20rpx; display: inline-block; word-break: break-word; }
.msg.mine { background: #6B5B95; color: #fff; border-bottom-right-radius: 8rpx; float: right; clear: both; }
.msg.theirs { background: #fff; border: 1rpx solid #e8e3dc; border-bottom-left-radius: 8rpx; float: left; clear: both; }
.tip { clear: both; display: block; margin: 12rpx auto; width: fit-content; }
.cin { display: flex; gap: 16rpx; align-items: center; padding: 18rpx 24rpx; background: #fff; border-top: 1rpx solid #e8e3dc; }
.ci { flex: 1; background: #FAF8F5; border: 2rpx solid #e8e3dc; border-radius: 40rpx; padding: 20rpx 28rpx; font-size: 30rpx; }
.snd { width: 80rpx; height: 80rpx; border-radius: 50%; background: #6B5B95; color: #fff; font-size: 36rpx; text-align: center; line-height: 80rpx; }
